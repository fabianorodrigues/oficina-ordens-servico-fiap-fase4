<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Oficina.OrdensServico.Application\Oficina.OrdensServico.Application.csproj" />
    <ProjectReference Include="..\Oficina.OrdensServico.Domain\Oficina.OrdensServico.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- A validacao do envelope de mensagem e interna e precisa de teste proprio:
         e ela que impede que uma mensagem malformada vire efeito de negocio. -->
    <InternalsVisibleTo Include="Oficina.OrdensServico.UnitTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.SQS" />
    <!-- Propagators e Baggage vivem em OpenTelemetry.Api: a Infrastructure
         precisa injetar e extrair contexto W3C no envelope da mensagem. -->
    <PackageReference Include="OpenTelemetry.Api" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
